<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="EMSME.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="TcpPort" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">7769</Value>
    </Setting>
    <Setting Name="Contact" Type="System.String" Scope="Application">
      <Value Profile="(Default)">software@sebastianlang.net</Value>
    </Setting>
    <Setting Name="Website" Type="System.String" Scope="Application">
      <Value Profile="(Default)">https://github.com/SebastianLang-GER/ems-manual-error</Value>
    </Setting>
    <Setting Name="Developer" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Sebastian Lang</Value>
    </Setting>
    <Setting Name="Description" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"EMS manual error" provides a simple button for EMC susceptibility test software to trigger EUT errors manually.
This tool was originally developed for R&amp;S®ELEKTRA. However, it is compatible with any EMS software that can integrate monitoring devices or tools via TCP/IP and SCPI commands.
"EMS manual error" is highly customizable for maximum compatablity with other software and ease of use according to your needs.

Credits:
